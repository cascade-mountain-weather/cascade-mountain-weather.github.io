source "https://rubygems.org"

# Matches the plugins GitHub Pages' Jekyll build environment supports.
# https://pages.github.com/versions/
gem "jekyll", "~> 4.3"
gem "jekyll-sitemap"

# Windows/JRuby compatibility shims that github-pages normally pulls in.
gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
